{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dashboard",
  "rewrites": [
    { "source": "/", "destination": "/template.html" },
    { "source": "/report.json", "destination": "https://api.wavey.info/api/vyper-grant/report" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Content-Disposition", "value": "inline" }]
    }
  ]
}
